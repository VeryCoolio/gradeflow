{
  "name": "muendliche-notengebung-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win portable",
    "desktop:package": "npm run build && electron-packager . Muendliche-Notengebung --platform=win32 --arch=x64 --out=release --overwrite"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@supabase/supabase-js": "^2.103.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "typescript": "^6.0.2",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "de.yanni.notenheft.desktop",
    "productName": "Muendliche Notengebung",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
